{
  "name": "header-guard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local HTTP response header review with explicit limitations.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "source": "python3 scripts/package-source.py",
    "analyze": "node cli.mjs",
    "start": "python3 -m http.server 8080 --bind 127.0.0.1 --directory dist"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
